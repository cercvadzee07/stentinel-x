# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL server (production). When unset, SENTINEL X uses PGlite — the
# PostgreSQL engine compiled to WASM — embedded in-process and stored in PGLITE_DIR.
# DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel
# DATABASE_POOL_MAX=10
PGLITE_DIR=.data/pglite

# ── Demo tenant ──────────────────────────────────────────────────────────
# Seed the "ACME Corp" demo organization, users and assets on first boot (0 = off)
SEED_DEMO=1
# Shared password for the seeded demo accounts (see src/server/db/seed.ts)
# DEMO_PASSWORD=
# List demo accounts on the login page (0 = hide)
DEMO_MODE=1

# ── Auth ─────────────────────────────────────────────────────────────────
# Self-service organization sign-up (0 = disabled)
ALLOW_SIGNUP=1
# Force the Secure cookie flag (it is set automatically behind HTTPS / x-forwarded-proto=https)
# COOKIE_SECURE=1

# ── Scan Center ──────────────────────────────────────────────────────────
# Authorized ranges are managed per organization in the UI (System Admin role).
# Enable the real nmap engine ONLY on a host that is authorized to scan those networks.
SCAN_ENABLE_NMAP=0
# NMAP_PATH=/usr/bin/nmap
# Allow allowlisting/scanning public (non-RFC 1918) ranges. Leave off unless you own them.
SCAN_ALLOW_PUBLIC=0
